{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheGatewayAndOnlyTagged",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:role/gatewayd-base"
      },
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/cost_center": "*",
          "aws:RequestTag/workload": "*"
        }
      }
    }
  ]
}
