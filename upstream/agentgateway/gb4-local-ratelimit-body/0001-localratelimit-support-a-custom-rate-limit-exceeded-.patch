index 00000000..ccc82c62
--- /dev/null
+++ b/crates/agentgateway/src/http/localratelimit_tests.rs
@@ -0,0 +1,203 @@
+use super::*;
+use crate::http::StatusCode;
+
+/// Helper: build a `RateLimit` that allows one request before rejecting.
+fn make_rate_limit(response: Option<RateLimitResponse>) -> RateLimit {
+	RateLimit::try_from(RateLimitSpec {
+		max_tokens: 1,
+		tokens_per_fill: 1,
+		fill_interval: std::time::Duration::from_secs(3600),
+		limit_type: RateLimitType::Requests,
+		response,
+	})
+	.expect("valid rate limit spec")
+}
+
+/// Helper: exhaust the limiter and return the rejection error.
+fn exhaust(rl: &RateLimit) -> ProxyError {
+	rl.check_request().expect("first request is allowed");
+	rl.check_request()
+		.expect_err("second request is rate limited")
+}
+
+#[tokio::test]
+async fn rejection_defaults_to_plain_text_429() {
+	let rl = make_rate_limit(None);
+	let response = exhaust(&rl).into_response_with_grpc(false);
+
+	assert_eq!(response.status(), StatusCode::TOO_MANY_REQUESTS);
+	assert_eq!(
+		response
+			.headers()
+			.get(::http::header::CONTENT_TYPE)
+			.unwrap(),
+		"text/plain"
+	);
+	let body = crate::http::read_body_with_limit(response.into_body(), 1024)
+		.await
+		.unwrap();
+	assert_eq!(body.as_ref(), b"rate limit exceeded");
+}
+
+#[tokio::test]
+async fn rejection_uses_custom_response() {
+	let rl = make_rate_limit(Some(RateLimitResponse {
+		body: Bytes::from_static(b"{\"error\":\"slow down\"}"),
+		content_type: Some("application/json".into()),
+		status: Some(StatusCode::SERVICE_UNAVAILABLE),
+	}));
+	let response = exhaust(&rl).into_response_with_grpc(false);
+
+	assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+	assert_eq!(
+		response
+			.headers()
+			.get(::http::header::CONTENT_TYPE)
+			.unwrap(),
+		"application/json"
+	);
+	// The rate limit headers are attached regardless of the custom response
+	assert_eq!(
+		response
+			.headers()
+			.get(crate::http::x_headers::X_RATELIMIT_LIMIT)
+			.unwrap(),
+		"1"
+	);
+	let body = crate::http::read_body_with_limit(response.into_body(), 1024)
+		.await
+		.unwrap();
+	assert_eq!(body.as_ref(), b"{\"error\":\"slow down\"}");
+}
+
+#[tokio::test]
+async fn custom_response_defaults_status_and_content_type() {
+	let rl = make_rate_limit(Some(RateLimitResponse {
+		body: Bytes::from_static(b"try again later"),
+		content_type: None,
+		status: None,
+	}));
+	let response = exhaust(&rl).into_response_with_grpc(false);
+
+	assert_eq!(response.status(), StatusCode::TOO_MANY_REQUESTS);
+	assert_eq!(
+		response
+			.headers()
+			.get(::http::header::CONTENT_TYPE)
+			.unwrap(),
+		"text/plain"
+	);
+	let body = crate::http::read_body_with_limit(response.into_body(), 1024)
+		.await
+		.unwrap();
+	assert_eq!(body.as_ref(), b"try again later");
+}
+
+#[tokio::test]
+async fn grpc_rejection_ignores_custom_body() {
+	let rl = make_rate_limit(Some(RateLimitResponse {
+		body: Bytes::from_static(b"{\"error\":\"slow down\"}"),
+		content_type: Some("application/json".into()),
+		status: None,
+	}));
+	let response = exhaust(&rl).into_response_with_grpc(true);
+
+	// gRPC requests keep the trailers-only style response
+	assert_eq!(response.status(), StatusCode::OK);
+	assert_eq!(
+		response
+			.headers()
+			.get(::http::header::CONTENT_TYPE)
+			.unwrap(),
+		"application/grpc"
+	);
+	assert!(response.headers().contains_key("grpc-status"));
+	let body = crate::http::read_body_with_limit(response.into_body(), 1024)
+		.await
+		.unwrap();
+	assert!(body.is_empty());
+}
+
+#[test]
+fn llm_token_rejection_carries_custom_response() {
+	let rl = RateLimit::try_from(RateLimitSpec {
+		max_tokens: 5,
+		tokens_per_fill: 5,
+		fill_interval: std::time::Duration::from_secs(3600),
+		limit_type: RateLimitType::Tokens,
+		response: Some(RateLimitResponse {
+			body: Bytes::from_static(b"token budget exhausted"),
+			content_type: None,
+			status: None,
+		}),
+	})
+	.expect("valid rate limit spec");
+
+	let llm_request = crate::llm::LLMRequest {
+		input_tokens: Some(100),
+		input_format: crate::llm::InputFormat::Completions,
+		cache_convention: crate::llm::CacheTokenConvention::pending(),
+		request_model: "test-model".into(),
+		provider: "test-provider".into(),
+		streaming: false,
+		params: Default::default(),
+		prompt: None,
+		provider_state: None,
+	};
+	let err = rl
+		.check_llm_request(&llm_request)
+		.expect_err("request exceeds the token budget");
+	let ProxyError::RateLimitExceeded {
+		response: Some(response),
+		..
+	} = err
+	else {
+		panic!("expected RateLimitExceeded with a custom response, got {err}");
+	};
+	assert_eq!(response.body.as_ref(), b"token budget exhausted");
+}
+
+// --- Config deserialization tests ---
+
+#[test]
+fn config_without_response_deserializes() {
+	let yaml = r#"
+maxTokens: 10
+tokensPerFill: 1
+fillInterval: 60s
+"#;
+	let rl: RateLimit = serdes::yamlviajson::from_str(yaml).unwrap();
+	assert_eq!(rl.spec.max_tokens, 10);
+	assert!(rl.spec.response.is_none());
+}
+
+#[test]
+fn config_with_custom_response_deserializes() {
+	let yaml = r#"
+maxTokens: 10
+tokensPerFill: 1
+fillInterval: 60s
+response:
+  body: '{"error":"rate limited"}'
+  contentType: application/json
+  status: 503
+"#;
+	let rl: RateLimit = serdes::yamlviajson::from_str(yaml).unwrap();
+	let response = rl.spec.response.as_ref().expect("response is set");
+	assert_eq!(response.body.as_ref(), br#"{"error":"rate limited"}"#);
+	assert_eq!(response.content_type.as_deref(), Some("application/json"));
+	assert_eq!(response.status, Some(StatusCode::SERVICE_UNAVAILABLE));
+}
+
+#[test]
+fn config_with_unknown_response_field_is_rejected() {
+	let yaml = r#"
+maxTokens: 10
+tokensPerFill: 1
+fillInterval: 60s
+response:
+  body: "rate limited"
+  bodyExpression: "1 + 1"
+"#;
+	assert!(serdes::yamlviajson::from_str::<RateLimit>(yaml).is_err());
+}
