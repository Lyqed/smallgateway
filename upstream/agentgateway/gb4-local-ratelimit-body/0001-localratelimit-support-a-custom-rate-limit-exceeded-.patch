+	/// Content-Type of the response body. Defaults to `text/plain`.
+	#[serde(default, skip_serializing_if = "Option::is_none")]
+	pub content_type: Option<Strng>,
+	/// HTTP status code to return. Defaults to 429 (Too Many Requests).
