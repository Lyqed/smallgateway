+		skip_serializing_if = "is_default",
+		with = "http_serde::option::status_code"
+	)]
+	#[cfg_attr(feature = "schema", schemars(with = "Option<std::num::NonZeroU16>"))]
+	pub status: Option<StatusCode>,
 }
 
